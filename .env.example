# Generate a secure random SECRET_KEY (required, at least 32 characters):
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# The application refuses to start with the default or a short value.
SECRET_KEY=change-me-with-a-long-random-string

# Set to false only for local HTTP development (no HTTPS).
# When true the session cookie gets the Secure flag and HSTS is sent.
COOKIE_SECURE=true

# Comma-separated Host header allow-list, e.g. "recipes.example.com".
# "*" disables the check and is only safe if the reverse proxy validates Host.
ALLOWED_HOSTS=*

# Expose /api/docs, /api/redoc and /openapi.json. They describe the whole API
# surface to anonymous visitors, so keep this off in production.
ENABLE_DOCS=false

# Networks uvicorn accepts X-Forwarded-For from (the reverse proxy only).
# Never set this to "*": any client could then spoof its IP and bypass the
# rate limiter.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# Port exposed on the host (default: 8080)
PORT=8080
